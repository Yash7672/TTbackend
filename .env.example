# ---------------------------------------------------------------------------
# FIXORA — environment template
# Copy this file to `.env` before the first start:
#   bash / macOS / Git Bash :  cp .env.example .env
#   Windows PowerShell      :  Copy-Item .env.example .env
#
# These are LOCAL DEVELOPMENT values only. Change every password before any
# public deployment. Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# ------------------------------- Database ---------------------------------
MYSQL_DATABASE=fixora_db
MYSQL_USER=yashwanth
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
# Host port mapped to the MySQL container (3306 inside the container).
MYSQL_PORT=3307

# -------------------------------- Ports -----------------------------------
# Published host ports. The browser talks to the frontend port only.
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ------------------------------- Seed data --------------------------------
# true  -> load the demo catalogue (categories, services, packages, demo users)
# false -> start with an empty database (schema is still created)
SEED_ENABLED=true

# --------------------------------- AI -------------------------------------
# AI_PROVIDER=fallback   -> deterministic, catalogue-driven assistant (no key needed)
# AI_PROVIDER=anthropic  -> uses the Anthropic API through the backend only
AI_PROVIDER=fallback

# Leave empty to stay in fallback mode. Never expose this to the frontend.
ANTHROPIC_API_KEY=

# Model identifier for the Anthropic provider, e.g. claude-sonnet-4-5
AI_MODEL=

# HTTP timeout (seconds) for AI provider calls before falling back.
AI_TIMEOUT_SECONDS=20

# ------------------- Managed MySQL over TLS (e.g. Aiven) -------------------
# For Docker/Render. The backend image builds a PKCS12 truststore at startup
# from the Aiven CA (see Dockerfile + docker/entrypoint.sh), so no certificate
# or password is baked into the image. NEVER commit the real values.
#
# 1) Point the app at the managed server with CA verification enabled:
#SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=VERIFY_CA&serverTimezone=UTC
#SPRING_DATASOURCE_USERNAME=avnadmin
#SPRING_DATASOURCE_PASSWORD=
#
# 2) Truststore location (Linux path, set by the image) and its password:
#SPRING_DATASOURCE_SSL_TRUSTSTORE_URL=file:/app/certs/aiven-truststore.p12
#SPRING_DATASOURCE_SSL_TRUSTSTORE_TYPE=PKCS12
#SPRING_DATASOURCE_SSL_TRUSTSTORE_PASSWORD=
#
# 3) Provide the CA certificate at run time (choose ONE):
#    a. Mounted file / Render Secret File at /etc/secrets/aiven-ca.pem (recommended)
#    b. Base64-encoded CA in this env var:
#AIVEN_CA_PEM_BASE64=
#    c. Path to a mounted CA file:
#AIVEN_CA_FILE=
#
#    The image starts as root ONLY long enough to read the CA material (Render
#    mounts Secret Files root-only, e.g. -r-------- root root before that was
#    fixed), builds the PKCS12 truststore, and then drops privileges to the
#    unprivileged `fixora` user to run the JVM. sslMode=VERIFY_CA is kept on.
#
# 4) Run the container. Put ONLY the connection keys above in a local,
#    git-ignored env file (never on the command line) and pass it with
#    --env-file so passwords are never printed in the terminal:
#
#    docker run --rm -p 8081:8080 \
#      --env-file .env.aiven \
#      -v "$PWD/certs/aiven-ca.pem:/etc/secrets/aiven-ca.pem:ro" \
#      fixora-backend
#
#    Note: plain `docker run` does NOT read `.env`; and `docker compose` in this
#    repo targets the local MySQL service. Use --env-file (or Render env vars)
#    for Aiven. The image already sets the Linux truststore URL/type, so
#    .env.aiven only needs URL, username, password and truststore password.

